#!/usr/bin/env sh

# 커밋 메시지 읽기
commit_msg=$(cat "$1")

# Conventional Commits 패턴
# 형식: type: subject
pattern="^(feat|fix|docs|style|refactor|test|setting|ci|chore): .{1,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ 커밋 메시지가 컨벤션에 맞지 않습니다!"
  echo ""
  echo "✅ 올바른 형식: <type>: <subject>"
  echo ""
  echo "📌 사용 가능한 타입:"
  echo "  - feat:     새로운 기능"
  echo "  - fix:      버그 수정"
  echo "  - docs:     문서 변경"
  echo "  - style:    스타일 관련"
  echo "  - refactor: 리팩토링"
  echo "  - test:     테스트 추가/수정"
  echo "  - setting:  환경 설정 변경"
  echo "  - ci:       CI 설정 변경"
  echo "  - chore:    그 외 작업"
  echo ""
  echo "📝 예시:" -> 한글 예시로..
  echo "  feat: 로그인 기능 추가"
  echo "  fix: CORS 이슈 수정"
  echo "  docs: README 업데이트"
  echo ""
  echo "현재 메시지: $commit_msg"
  exit 1
fi