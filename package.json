{
  "name": "web24-boostcamp",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "dev": "pnpm -F @web24/frontend dev",
    "dev:push": "pnpm -F @web24/frontend build && pnpm -F @web24/proto dev:push",
    "build": "pnpm -F @web24/frontend build",
    "preview": "pnpm -F @web24/frontend preview",
    "typecheck": "pnpm -F @web24/frontend typecheck",
    "test": "pnpm -F @web24/frontend test",
    "test:run": "pnpm -F @web24/frontend test:run",
    "test:e2e": "pnpm -F @web24/frontend test:e2e",
    "lint": "pnpm -F @web24/frontend lint",
    "format": "pnpm -F @web24/frontend format",
    "format:check": "pnpm -F @web24/frontend exec prettier --check .",
    "ci:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:run",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx}": [
      "pnpm -F @web24/frontend format",
      "pnpm -F @web24/frontend lint --fix"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
