{
  "name": "web24-boostcamp",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "format": "pnpm -r format",
    "build": "pnpm run build:fe && pnpm run build:be",
    "build:fe": "pnpm -F @web24/frontend build",
    "build:be": "pnpm -F @web24/backend build",
    "dev": "concurrently \"pnpm run dev:fe\" \"pnpm run dev:be\"",
    "dev:fe": "pnpm -F @web24/frontend dev",
    "dev:be": "pnpm -F @web24/backend dev",
    "test": "concurrently \"pnpm run test:fe\" \"pnpm run test:be\"",
    "test:fe": "pnpm -F @web24/frontend test",
    "test:fe:run": "pnpm -F @web24/frontend test:run",
    "test:fe:e2e": "pnpm -F @web24/frontend test:e2e",
    "test:be": "pnpm -F @web24/backend test",
    "lint": "concurrently \"pnpm run lint:fe\" \"pnpm run lint:be\"",
    "lint:fe": "pnpm -F @web24/frontend lint",
    "lint:be": "pnpm -F @web24/backend lint",
    "preview": "pnpm -F @web24/frontend preview",
    "typecheck": "concurrently \"pnpm run typecheck:fe\" \"pnpm run typecheck:be\"",
    "typecheck:fe": "pnpm -F @web24/frontend typecheck",
    "typecheck:be": "pnpm -F @web24/backend typecheck",
    "format:check": "concurrently \"pnpm -F @web24/frontend format:check\" \"pnpm -F @web24/backend format:check\"",
    "ci:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx}": [
      "pnpm -F @web24/frontend format",
      "pnpm -F @web24/frontend lint --fix"
    ],
    "apps/backend/**/*.ts": [
      "pnpm -F @web24/backend format",
      "pnpm -F @web24/backend lint --fix"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
