    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "react-toastify": "^11.0.5",
    "swiper": "^12.0.3",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4.1.18",
