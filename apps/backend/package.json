{
  "name": "@web24/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "pnpm exec prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "cross-env NODE_ENV=development node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/common/database/data-source.ts",
    "typeorm:prod": "cross-env NODE_ENV=production node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/common/database/data-source.ts",
    "migration:generate": "pnpm run typeorm migration:generate ./src/common/database/migrations/auto",
    "migration:generate:prod": "pnpm run typeorm:prod migration:generate ./src/common/database/migrations/auto",
    "migration:create": "cross-env NODE_ENV=development node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create ./src/common/database/migrations/manual",
    "migration:create:prod": "cross-env NODE_ENV=production node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create ./src/common/database/migrations/manual",
    "migration:run": "pnpm run typeorm migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d ./dist/common/database/data-source.js migration:run",
    "migration:revert": "pnpm run typeorm migration:revert",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js -d ./dist/common/database/data-source.js migration:revert",
    "seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/common/database/seed.ts",
    "stat:daily": "cross-env NODE_ENV=development TS_NODE_FILES=true ts-node -r tsconfig-paths/register src/common/scripts/run-daily-user-stats.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.38.0",
    "@sentry/profiling-node": "^10.38.0",
    "@web24/shared": "workspace:*",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express-session": "^1.18.2",
    "joi": "^18.0.2",
    "p-limit": "^3.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
